---
/**
 * The API reference: Scalar's renderer over Payment Sandbox's OpenAPI document (/openapi.json — a
 * draft authored in this repository and kept in sync with the server's routes by
 * scripts/check-openapi.mjs). Scalar runs from this site's own copy of its browser build, at the
 * version package.json pins, with its telemetry, hosted fonts and AI assistant switched off.
 * A full-width page of its own, since Scalar brings its own navigation.
 */
import spec from '../../data/openapi.json';

const title = 'API reference · Payment Sandbox Docs';
const description =
	'Every route of Payment Sandbox’s HTTP API — projects and keys, payments, the ledger, checkout sessions, webhook endpoints and health — generated from its OpenAPI document, with request examples and try-it. SIMULATED MONEY ONLY.';
const canonical = new URL('/api/reference/', Astro.site).href;
const paths = Object.keys(spec.paths).length;
const operations = Object.values(spec.paths).reduce(
	(sum: number, item) => sum + Object.keys(item as object).filter((key) => ['get', 'post', 'put', 'patch', 'delete'].includes(key)).length,
	0,
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<script is:inline>
			// The docs' own theme choice, so this page opens in the same light or dark.
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('starlight-theme');
				} catch {}
				const dark = stored === 'dark' || ((stored === null || stored === 'auto' || stored === '') && matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.dataset.theme = dark ? 'dark' : 'light';
			})();
		</script>
		<style is:global>
			:root {
				--ink: #0a0a0a;
				--muted: #5e5e5e;
				--line: #e5e5e5;
				--bg: #ffffff;
				--accent: #3f3f46;
				color-scheme: light;
			}
			:root[data-theme='dark'] {
				--ink: #f5f5f5;
				--muted: #9c9c9c;
				--line: #2a2a2a;
				--bg: #121212;
				--accent: #c9c9ce;
				color-scheme: dark;
			}
			html,
			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
			}
			.ref-bar {
				position: sticky;
				top: 0;
				z-index: 20;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5rem 1rem;
				padding: 0.625rem 16px;
				background: var(--bg);
				border-bottom: 1px solid var(--line);
				font-size: 0.875rem;
			}
			.ref-bar a {
				color: inherit;
				text-decoration: none;
			}
			.ref-home {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-weight: 600;
			}
			.ref-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1rem;
				margin-inline-start: auto;
				color: var(--muted);
			}
			.ref-links a:hover,
			.ref-home:hover {
				color: var(--accent);
			}
			.ref-note {
				margin: 0;
				padding: 0.625rem 16px;
				font-size: 0.8125rem;
				line-height: 1.5;
				color: var(--muted);
				border-bottom: 1px solid var(--line);
			}
			.ref-note code {
				font-size: 0.95em;
			}
			.ref-note a {
				color: var(--accent);
			}
			noscript p {
				padding: 1rem 16px;
			}
		</style>
	</head>
	<body>
		<header class="ref-bar">
			<a class="ref-home" href="/">Payment Sandbox Docs</a>
			<span aria-hidden="true">/</span>
			<span>API reference</span>
			<nav class="ref-links" aria-label="Docs">
				<a href="/">Documentation</a>
				<a href="/openapi.json">openapi.json</a>
			</nav>
		</header>
		<p class="ref-note">
			<strong>SIMULATED MONEY ONLY:</strong> Payment Sandbox moves no real money and accepts no real cards.
			{operations} operations on {paths} paths, generated from the OpenAPI document this site serves at <code>/openapi.json</code>
			(version {spec.info.version}; a draft kept in sync with the server's routes by CI).
			The examples call <code>https://sandbox.example.com</code>, a reserved example domain; pick <strong>the quick start on this machine</strong>
			under <strong>Server</strong>, or set <strong>Your Payment Sandbox URL</strong> on an API page and it comes first here. The API answers
			browser requests only from its own origins, so <strong>Test Request</strong> from this page reaches your server only if the browser allows it:
			otherwise copy the request as <code>curl</code> from the code samples. Put a sandbox key (<code>sk_sim_…</code>) in
			<strong>Authentication</strong> only for a local or test server. <a href="/">The docs</a>.
		</p>
		<div id="reference"></div>
		<noscript><p>The interactive reference needs JavaScript. The document itself is at <a href="/openapi.json">/openapi.json</a>.</p></noscript>
		<script type="module" is:inline>
			import { createApiReference } from '/scalar/standalone.esm.js';
			// The reader's own server, if they set one on an API page (src/lib/your-url.ts holds the
			// same rule: https, or http for this machine; the origin only). Kept in this browser.
			const servers = [
				{ url: 'https://sandbox.example.com', description: 'Your Payment Sandbox (an example domain: enter yours on an API page)' },
				{ url: 'http://127.0.0.1:56080', description: 'The quick start on this machine' },
			];
			try {
				const stored = new URL(localStorage.getItem('payment-sandbox-docs:server') ?? '');
				const local = ['localhost', '127.0.0.1', '[::1]'].includes(stored.hostname);
				if (stored.protocol === 'https:' || (stored.protocol === 'http:' && local)) {
					servers.unshift({ url: stored.origin, description: 'Your Payment Sandbox' });
				}
			} catch {}
			const dark = document.documentElement.dataset.theme === 'dark';
			createApiReference('#reference', {
				url: '/openapi.json',
				servers,
				authentication: { preferredSecurityScheme: 'sandboxKey' },
				defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
				darkMode: dark,
				hideDarkModeToggle: true,
				withDefaultFonts: false,
				telemetry: false,
				showDeveloperTools: 'never',
				agent: { disabled: true },
				hideClientButton: false,
				persistAuth: false,
				// No request proxy. Test Request goes straight from the reader's browser to the server they
				// chose, never through proxy.scalar.com. Scalar 1.76 uses an explicit proxyUrl as given, and an
				// empty one means no proxy. Left unset, it falls back to its hosted proxy only in its own
				// "web" layout, which this page doesn't use. The empty value pins that down across upgrades,
				// and CI's privacy job (scripts/check-privacy.mjs) fails if a version starts proxying anyway. It
				// tries a remote https server as well as a local one, because Scalar never proxies localhost.
				proxyUrl: '',
				metaData: { title: 'API reference · Payment Sandbox Docs' },
				customCss: `
					.scalar-app, .scalar-api-reference { --scalar-font: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif; --scalar-font-code: ui-monospace, SFMono-Regular, Menlo, monospace; }
					.light-mode { --scalar-color-accent: #3f3f46; --scalar-background-1: #ffffff; --scalar-color-3: #636363; }
					.dark-mode { --scalar-color-accent: #c9c9ce; --scalar-background-1: #121212; --scalar-color-3: #a3a3a3; }
				`,
			});
		</script>
	</body>
</html>
